# Canonical public origin. Set this to the final HTTPS domain in production.
SITE_URL=https://designlens-p9yd.onrender.com

# Optional Google Analytics 4 measurement ID (public identifier, not a secret).
# Analytics is not loaded until the visitor explicitly consents.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional narrative synthesis. If absent, DesignLens uses deterministic local synthesis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional provider-neutral endpoint (OpenAI-compatible chat completions API).
# When set, it takes precedence over OpenAI's default endpoint.
LLM_BASE_URL=https://api.openai.com/v1

# Optional rate limit settings.
ANALYZE_RATE_LIMIT=5
ANALYZE_RATE_WINDOW_MS=600000

# Playwright local browser path can be set if Chromium is installed elsewhere.
# PLAYWRIGHT_EXECUTABLE_PATH=
