# ==============================================================================
# DesignLens Environment Configuration
# ==============================================================================

# Canonical public origin. Set this to your final HTTPS domain in production (e.g. https://designlens.app).
SITE_URL=https://designlens-p9yd.onrender.com

# ------------------------------------------------------------------------------
# Supabase Authentication & Workspace Database (Required for persistent studio)
# ------------------------------------------------------------------------------
# Find these in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Optional: Supabase Service Role Key (Server-only administrative operations/testing)
# Never expose this key to client components or public scripts.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Production OAuth Callback URLs to whitelist in Supabase Auth -> URL Configuration:
# - Site URL: https://your-domain.com
# - Redirect URLs:
#   - http://localhost:3000/auth/callback
#   - https://your-domain.com/auth/callback

# ------------------------------------------------------------------------------
# Analytics (Optional)
# ------------------------------------------------------------------------------
# Google Analytics 4 measurement ID (public identifier, not a secret).
# Loaded only after explicit visitor cookie consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# Narrative AI Synthesis (Optional)
# ------------------------------------------------------------------------------
# If absent, DesignLens uses deterministic local synthesis with zero external dependencies.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional provider-neutral endpoint (OpenAI-compatible chat completions API).
# When set, it takes precedence over OpenAI's default endpoint.
LLM_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# Rate Limiting & Resource Protection
# ------------------------------------------------------------------------------
ANALYZE_RATE_LIMIT=5
ANALYZE_RATE_WINDOW_MS=600000

# Playwright local browser path (optional if Chromium is installed in custom path)
# PLAYWRIGHT_EXECUTABLE_PATH=
